{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults plus exactly the plugin permissions the pages use (no shell, no fs)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**/logs/jobs/*"
        }
      ]
    },
    "core:window:allow-close"
  ]
}
