{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bayle Dev",
  "mainBinaryName": "Bayle",
  "identifier": "io.github.carlomos7.bayle.dev",
  "version": "6.0.0-beta.1",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bayle Dev",
        "width": 1280,
        "height": 820,
        "minWidth": 390,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../target/engine-dist/bayle-engine/": "engine/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5M0ZDNjRDQUEyQjU4MUUKUldRZVdDdXFUTVkvQ2FVU1ZQK0hHV0I3VDViZEp0VEhJWHVzVU1SeEVVVUp4S3ZCL3JjVmh2cE8K",
      "endpoints": [
        "http://127.0.0.1:8765/beta.json"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
