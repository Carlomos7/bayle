  "info": {
    "title": "Bayle API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/events": {
      "get": {
        "description": "Ordered job events. `id` is the seq, `event` the type. Reconnect with Last-Event-ID to continue.",
        "operationId": "events",
        "parameters": [
          {
            "in": "header",
            "name": "last-event-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "properties": {
                    "data": {
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "discriminator": {
                          "mapping": {
                            "cancelled": "#/components/schemas/CancelledEvent",
                            "failed": "#/components/schemas/FailedEvent",
                            "finished": "#/components/schemas/FinishedEvent",
                            "log": "#/components/schemas/LogEvent",
                            "progress": "#/components/schemas/ProgressEvent",
                            "prompt": "#/components/schemas/PromptEvent",
                            "resync": "#/components/schemas/ResyncEvent",
                            "started": "#/components/schemas/StartedEvent"
                          },
                          "propertyName": "type"
                        },
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/StartedEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ProgressEvent"
                          },
                          {
                            "$ref": "#/components/schemas/LogEvent"
                          },
                          {
                            "$ref": "#/components/schemas/PromptEvent"
                          },
                          {
                            "$ref": "#/components/schemas/FinishedEvent"
                          },
                          {
                            "$ref": "#/components/schemas/FailedEvent"
                          },
                          {
                            "$ref": "#/components/schemas/CancelledEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ResyncEvent"
                          }
                        ],
                        "title": "Streamitem Events"
                      },
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Events"
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Health"
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "operationId": "get_job",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Job"
      }
    },
    "/v1/jobs/{job_id}/cancel": {
      "post": {
        "description": "Ask the job to stop (it ends with a `cancelled` event). Idempotent: a job that is over just reports its state.",
        "operationId": "cancel_job",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Cancel Job"
      }
    }
  }
}
