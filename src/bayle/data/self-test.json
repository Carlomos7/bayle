    "bayle.overhauls",
    "bayle.platform.logging",
    "bayle.runtime.bootstrap",
    "bayle.saves",
    "bayle.services.play",
    "bayle.storage.db",
    "bayle.updates.apply",
    "alembic",
    "constrata",
    "cryptography",
    "py7zr",
    "pydantic",
    "sqlalchemy",
    "tomlkit",
    "velopack"
  ],
  "files": [
    {"path": "assets/icon.ico"},
    {"path": "data/release-signing.pub"},
    {"path": "data/update-watchdog.ps1"},
    {"path": "data/update-watchdog.sh"},
    {"glob": "data/games/*.json", "min": 1},
    {"glob": "data/schemas/*.json", "min": 2},
    {"path": "storage/migrations/env.py"},
    {"glob": "storage/migrations/versions/*.py", "min": 2}
  ]
