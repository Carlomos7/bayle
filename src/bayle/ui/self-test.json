{
  "$comment": "The Qt half of the --self-test requirements (see data/self-test.json for the engine half). qml_modules is what pyside6-qmlimportscanner finds in ui/qml (tests/unit/test_self_test.py keeps them in step). files are relative to the package; min is the least number of matches a glob must have.",
  "python_modules": [
    "bayle.ui.qml_env",
    "bayle.ui.launcher.window",
    "PySide6.QtQml",
    "PySide6.QtQuick",
    "PySide6.QtQuickControls2",
    "PySide6.QtSvg"
  ],
  "qml_modules": [
    "App",
    "Components",
    "QtQml.Models",
    "QtQuick",
    "QtQuick.Controls.Basic",
    "QtQuick.Controls.impl",
    "QtQuick.Dialogs",
    "QtQuick.Effects",
    "QtQuick.Layouts",
    "QtQuick.Window",
    "Roundtable.Code",
    "Shell",
    "Theme"
  ],
  "files": [
    {"path": "ui/qml/Main.qml"},
    {"path": "ui/qml/MessageWindow.qml"},
    {"path": "ui/qml/Shell/qmldir"},
    {"glob": "ui/qml/Shell/*.qml", "min": 5},
    {"path": "ui/qml/Theme/Theme.qml"},
    {"path": "ui/qml/Theme/qmldir"},
    {"path": "ui/qml/App/qmldir"},
    {"path": "ui/qml/Components/qmldir"},
    {"glob": "ui/qml/Pages/*.qml", "min": 1},
    {"glob": "ui/assets/fonts/*.ttf", "min": 9},
    {"glob": "ui/assets/fonts/*-LICENSE.txt", "min": 3},
    {"glob": "ui/assets/icons/*.svg", "min": 52},
    {"path": "ui/assets/icons/LICENSE.txt"},
    {"glob": "ui/assets/atmosphere/*.png", "min": 7}
  ]
}
