    "roundtable_souls.mods.undo",
    "roundtable_souls.overhauls",
    "roundtable_souls.platform.logging",
    "roundtable_souls.saves",
    "roundtable_souls.services.play",
    "roundtable_souls.storage.db",
    "roundtable_souls.ui.qml_env",
    "roundtable_souls.ui.launcher.window",
    "roundtable_souls.updates.apply",
    "PySide6.QtQml",
    "PySide6.QtQuick",
    "PySide6.QtQuickControls2",
    "PySide6.QtSvg",
    "alembic",
    "constrata",
    "cryptography",
    "py7zr",
    "pydantic",
    "sqlalchemy",
    "velopack"
  ],
  "qml_modules": [
    "App",
    "Components",
    "QtQml.Models",
    "QtQuick",
    "QtQuick.Controls.Basic",
    "QtQuick.Controls.impl",
    "QtQuick.Dialogs",
    "QtQuick.Effects",
    "QtQuick.Layouts",
    "QtQuick.Window",
    "Shell",
    "Theme"
  ],
  "files": [
    {"path": "assets/icon.ico"},
    {"path": "data/release-signing.pub"},
    {"path": "data/update-watchdog.ps1"},
    {"path": "data/update-watchdog.sh"},
    {"glob": "data/games/*.json", "min": 1},
    {"glob": "data/schemas/*.json", "min": 2},
    {"path": "storage/migrations/env.py"},
    {"glob": "storage/migrations/versions/*.py", "min": 2},
    {"path": "ui/qml/Main.qml"},
    {"path": "ui/qml/MessageWindow.qml"},
    {"path": "ui/qml/Shell/qmldir"},
    {"glob": "ui/qml/Shell/*.qml", "min": 5},
    {"path": "ui/qml/Theme/Theme.qml"},
    {"path": "ui/qml/Theme/qmldir"},
    {"path": "ui/qml/App/qmldir"},
    {"path": "ui/qml/Components/qmldir"},
    {"glob": "ui/qml/Pages/*.qml", "min": 1},
    {"glob": "ui/assets/fonts/*.ttf", "min": 9},
    {"glob": "ui/assets/fonts/*-LICENSE.txt", "min": 3},
    {"glob": "ui/assets/icons/*.svg", "min": 52},
    {"path": "ui/assets/icons/LICENSE.txt"},
    {"glob": "ui/assets/atmosphere/*.png", "min": 7}
  ]
